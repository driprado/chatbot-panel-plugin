{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/master/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Chatbot",
  "id": "driprado-chatbot-panel",
  "routes": [
    {
      "path": "/logql-agent",
      "url": "http://logql-agent:80",
      "method": "POST"
    }
  ],
  "info": {
    "description": "Chatbot UI panel",
    "author": {
      "name": "driprado",
      "url": "https://github.com/driprado"
    },
    "keywords": ["chatbot", "panel", "ai", "conversation"],
    "logos": {
      "small": "img/chatbot-grafana-plugin-icon.svg",
      "large": "img/chatbot-grafana-plugin-icon.svg"
    },
    "links": [
      {
        "name": "Repository",
        "url": "https://github.com/driprado/chatbot-panel-plugin"
      },
      {
        "name": "License",
        "url": "https://github.com/driprado/chatbot-panel-plugin/blob/main/chatbot-panel-plugin/LICENSE"
      },
      {
        "name": "Sponsor",
        "url": "https://github.com/sponsors/driprado"
      }
    ],
    "screenshots": [
      {
        "name": "Chatbot Dashboard",
        "path": "img/screenshot-chatbot-dashboard.png"
      },
      {
        "name": "Chatbot Visualisation Options",
        "path": "img/screenshot-chatbot-visualisation-option.png"
      }
    ],
    "version": "1.0.1",
    "updated": "2026-05-12"
  },
  "dependencies": {
    "grafanaDependency": ">=7.0.0",
    "plugins": []
  }
}